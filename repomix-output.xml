<div [class.presenter-mode]="characterState.presenterMode()" class="min-h-screen flex flex-col p-4 md:p-6 max-w-[1800px] mx-auto transition-all duration-300">
  
  <!-- Header Component -->
  <header class="mb-6 w-full">
    <app-header></app-header>
  </header>

  <!-- Main Side-by-Side Grid Layout -->
  <main class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start flex-1 w-full">
    
    <!-- LEFT SIDE: Selection Boxes / Customizer Panel (6 Columns) -->
    <section class="lg:col-span-6 w-full h-full transition-all duration-300">
      <div class="card-glass p-4 md:p-5 h-full flex flex-col justify-between">
        <app-customizer-panel></app-customizer-panel>
      </div>
    </section>

    <!-- RIGHT SIDE: Character Canvas OR Code Peeker (6 Columns) -->
    <section class="lg:col-span-6 w-full h-full transition-all duration-300">
      
      <!-- Show 2D Character Canvas when Code Peeker is CLOSED -->
      @if (!characterState.codePeekerOpen()) {
        <div class="card-glass p-6 md:p-8 h-full flex flex-col items-center justify-center relative overflow-hidden min-h-[600px] animate-fadeIn">
          <!-- Subtle Grid Background -->
          <div class="absolute inset-0 bg-[radial-gradient(#38BDF8_1px,transparent_1px)] [background-size:24px_24px] opacity-10 pointer-events-none"></div>

          <!-- 2D Character Canvas -->
          <app-character-canvas class="w-full flex justify-center z-10"></app-character-canvas>
        </div>
      }

      <!-- Show Code Inspector in place of Character Canvas when Code Peeker is OPEN -->
      @if (characterState.codePeekerOpen()) {
        <aside class="w-full h-full animate-fadeIn">
          <div class="card-glass p-5 h-full border-l-2 border-l-cyan-400/40">
            <app-code-peeker></app-code-peeker>
          </div>
        </aside>
      }

    </section>

  </main>

  <!-- Footer -->
