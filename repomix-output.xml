      font-weight: 700;
      color: #C084FC;
      margin-bottom: 0.35rem;
    }

    .formula-pre {
      font-family: var(--font-code);
      font-size: 0.72rem;
      color: #CBD5E1;
      line-height: 1.45;
      margin: 0;
      white-space: pre-wrap;
    }

    .formula-pre code {
      font-family: inherit;
    }

    .formula-actions {
      margin-top: 0.5rem;
      display: flex;
      justify-content: flex-end;
    }

    .reset-btn {
      background: transparent;
      border: 1px solid var(--border-subtle);
      color: #94A3B8;
      padding: 0.2rem 0.55rem;
      border-radius: 0.35rem;
      font-size: 0.68rem;
      font-family: var(--font-code);
      cursor: pointer;
      transition: all 0.2s;
    }

    .reset-btn:hover {
      border-color: #F87171;
      color: #F87171;
    }

    .mt-3 {
      margin-top: 0.75rem;
    }
  `]
})
export class CustomizerPanelComponent {
  state = inject(CharacterStateService);
  private sanitizer = inject(DomSanitizer);

  // The icon paths are our own constants, so it's safe to trust them.
  // Without this, Angular's sanitizer strips <path> and the icons render blank.
  classes = CLASSES.map((c) => ({
    ...c,
    icon: this.sanitizer.bypassSecurityTrustHtml(c.iconSvg)
  }));

  displayedHats = HATS.filter(h => ['horned-helm', 'wizard-hat', 'cyber-visor', 'hero-crown'].includes(h.id));
  displayedOutfits = OUTFITS.filter(o => ['plate-armor', 'archmage-robe', 'cyber-exosuit'].includes(o.id));
  weapons = WEAPONS;
  specialPowers = SPECIAL_POWERS;
  skinPalettes = SKIN_PALETTES;

  get heroName(): string {
    return this.state.characterName();
  }
  set heroName(val: string) {
    this.state.setName(val);
  }

  onColorInput(e: Event): void {
    const input = e.target as HTMLInputElement;
    if (input) {
      this.state.setSkinColor(input.value);
    }
  }

  // Reads the same attackBreakdown() the real total uses, so the display can't drift.
  getFormulaText(): string {
    const b = this.state.attackBreakdown();
    return `totalAttackPower = computed(() => {
  base            = ${b.base}
  ${b.primaryKey} bonus = ${b.primaryTotal} × ${b.primaryMult} = ${b.primaryBonus.toFixed(1)}   (stat + gear)
  ${b.secondaryKey} bonus = ${b.secondaryTotal} × ${b.secondaryMult} = ${b.secondaryBonus.toFixed(1)}
  synergy         = +${b.synergy}
  aura            = ×${b.multiplier}
  return Math.round((base + bonuses + synergy) × aura)
  // => RESULT: ${b.total} ATK
});`;
  }

  openSignalsTab(): void {
    this.state.openCodePeekerWithTab('signals');
  }

  openBindingsTab(): void {
    this.state.openCodePeekerWithTab('bindings');
  }

  openDirectivesTab(): void {
    this.state.openCodePeekerWithTab('directives');
  }
}
