<file path="src/app/components/code-peeker/code-peeker.component.ts">
import { Component, HostListener, computed, inject, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { DomSanitizer, SafeHtml } from '@angular/platform-browser';
import { CharacterStateService } from '../../services/character-state.service';

/* ---------- tiny syntax highlighter (escape first, then colour tokens) ---------- */
const esc = (s: string): string =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const TS_TOKENS =
  /(?<comment>\/\/[^\n]*)|(?<str>'[^'\n]*')|(?<decl>\breadonly\s+\w+)|(?<call>\b(?:signal|computed|Math\.round)\b)|(?<kw>\b(?:readonly|const|let|return|if|this)\b)|(?<type>\b(?:string|boolean|number|RpgStats|HatItem|WeaponItem)\b)|(?<num>\b\d+(?:\.\d+)?\b)|(?<bool>\b(?:true|false)\b)/g;

const HTML_TOKENS =
  /(?<comment>&lt;!--[\s\S]*?--&gt;)|(?<str>"[^"\n]*")|(?<bind>\[\(?[\w.-]+\)?\]|\([\w.-]+\))(?==)|(?<attr>\b[\w-]+)(?==")|(?<ctl>@(?:else if|if|else|for)\b|\btrack\b)|(?<tag>&lt;\/?[\w-]+)|(?<interp>\{\{[^}\n]*\}\})/g;

const TS_STYLE: Record<string, string> = {
  comment: 'color:#64748b',
  str: 'color:#a5f3fc',
  call: 'color:#22c55e',
  kw: 'color:#a855f7',
  type: 'color:#fbbf24',
  num: 'color:#f87171',
  bool: 'color:#f43f5e'
};

const HTML_STYLE: Record<string, string> = {
  comment: 'color:#64748b',
  str: 'color:#a5f3fc',
  attr: 'color:#38bdf8',
  ctl: 'color:#c084fc;font-weight:bold',
  tag: 'color:#f43f5e',
  interp: 'color:#fde047'
};

const HOT = 'background:#fbbf2433;color:#fde047;padding:2px 4px;border-radius:4px';

function paint(code: string, lang: 'ts' | 'html', hotName = ''): string {
  const styles = lang === 'ts' ? TS_STYLE : HTML_STYLE;
  const re = lang === 'ts' ? TS_TOKENS : HTML_TOKENS;

  return esc(code).replace(re, (...args: unknown[]) => {
    const text = args[0] as string;
    const groups = args[args.length - 1] as Record<string, string | undefined>;
    const kind = Object.keys(groups).find((k) => groups[k] !== undefined) ?? '';

    if (kind === 'decl') {
      const m = /^(readonly)(\s+)(\w+)$/.exec(text);
      if (m) {
        const nameStyle = m[3] === hotName ? HOT : 'color:#38bdf8';
        return `<span style="color:#a855f7">${m[1]}</span>${m[2]}<span style="${nameStyle}">${m[3]}</span>`;
      }
    }

    if (kind === 'bind') {
      const style = text.startsWith('[(')
        ? 'color:#fbbf24;font-weight:bold'    // banana in a box
        : text.startsWith('[')
          ? 'color:#38bdf8;font-weight:bold'  // property / class binding
          : 'color:#10b981;font-weight:bold'; // event binding
      return `<span style="${style}">${text}</span>`;
    }

    return `<span style="${styles[kind] ?? ''}">${text}</span>`;
  });
}

@Component({
  selector: 'app-code-peeker',
  standalone: true,
  imports: [CommonModule],
  template: `
    <!-- Floating Action Trigger (Bottom Right) -->
    @if (!state.codePeekerOpen()) {
      <button
        class="floating-peeker-trigger"
        (click)="state.toggleCodePeeker()"
        title="Open Live Angular Code Peeker (Esc closes it)"
      >
        <span class="pulse-ring"></span>
        <span class="trigger-icon">👀</span>
        <span class="trigger-label">See How Angular Does This!</span>
      </button>
    }

    <!-- Slide-Over Drawer Backdrop -->
    @if (state.codePeekerOpen()) {
      <div class="drawer-backdrop" (click)="state.toggleCodePeeker()"></div>
    }

    <!-- Slide-Over Drawer Container -->
    <aside
      class="drawer-panel"
      [class.drawer-active]="state.codePeekerOpen()"
      [class.presenter-large]="state.presenterMode()"
      [attr.aria-hidden]="!state.codePeekerOpen()"
    >
      <!-- Drawer Header -->
      <div class="drawer-header">
        <div class="drawer-title-group">
          <span class="drawer-badge">ANGULAR 18+ ARCHITECTURE</span>
          <h2 class="drawer-title">Live Code Peeker</h2>
        </div>

        <div class="drawer-actions">
          <div class="font-zoom-group" title="Adjust code font size for projector">
            <button class="zoom-btn" (click)="adjustFontSize(-1)">A-</button>
            <button class="zoom-btn" (click)="adjustFontSize(1)">A+</button>
          </div>

          <button class="close-btn" (click)="state.toggleCodePeeker()" title="Close Drawer (Esc)" aria-label="Close code peeker">
            ✕
          </button>
        </div>
      </div>

      <!-- Reactive Signal Change Notification Pill -->
      <div class="signal-alert-banner">
        <span class="alert-pulse">⚡</span>
        <span class="alert-text">
          Live Reactive Node: <strong>{{ state.lastUpdatedSignal().name }}()</strong>
          &rarr; updated to <em class="alert-value">"{{ state.lastUpdatedSignal().value }}"</em>
        </span>
      </div>

      <!-- Navigation Tabs -->
      <nav class="peeker-tabs">
        <button
          class="peeker-tab"
          [class.tab-active]="state.activeCodeTab() === 'signals'"
          (click)="state.setCodeTab('signals')"
        >
          <span class="tab-emoji">⚡</span>
          <span>Signals &amp; Computed</span>
        </button>

        <button
          class="peeker-tab"
          [class.tab-active]="state.activeCodeTab() === 'bindings'"
          (click)="state.setCodeTab('bindings')"
        >
          <span class="tab-emoji">🔗</span>
          <span>Data Bindings</span>
        </button>

        <button
          class="peeker-tab"
          [class.tab-active]="state.activeCodeTab() === 'directives'"
          (click)="state.setCodeTab('directives')"
        >
          <span class="tab-emoji">🔀</span>
          <span>Control Flow</span>
        </button>

        <button
          class="peeker-tab"
          [class.tab-active]="state.activeCodeTab() === 'state'"
          (click)="state.setCodeTab('state')"
        >
          <span class="tab-emoji">📊</span>
          <span>Live State Tree</span>
        </button>
      </nav>

      <!-- Tab Content 1: Signals & Computed -->
      @if (state.activeCodeTab() === 'signals') {
        <div class="tab-scroll-body">
          <div class="concept-explanation">
            <h4 class="concept-title">💡 What are Angular Signals?</h4>
            <p class="concept-desc">
              Signals are reactive state primitives introduced in Angular 16+ and fully mature in 18/19.
              Unlike standard variables, Signals notify only the exact DOM nodes that depend on them,
              eliminating heavy full-tree dirty checking!
            </p>
          </div>

          <div class="code-card">
            <div class="code-card-header">
              <div class="header-left">
                <div class="window-dots">
                  <span class="w-dot dot-red"></span>
                  <span class="w-dot dot-yellow"></span>
                  <span class="w-dot dot-green"></span>
                </div>
                <span class="filename">character-state.service.ts</span>
              </div>
              <div class="header-right">
                <span class="scroll-hint-pill">↕ Scrollable Code</span>
                <button class="copy-btn" (click)="copy(signalsCode())">
                  {{ copied() ? '✓ Copied' : '📋 Copy' }}
                </button>
              </div>
            </div>
            <pre class="code-block" [style.fontSize.px]="codeFontSize()"><code [innerHTML]="signalsHtml()"></code></pre>
          </div>

          <div class="concept-explanation mt-4">
            <h4 class="concept-title">🧮 What is computed()?</h4>
            <p class="concept-desc">
              <code>computed()</code> defines a memoized signal derived from other signals.
              Notice how <code>totalAttackPower()</code> recalculated to
              <strong>{{ state.totalAttackPower() }}</strong> automatically when you changed weapon or stats!
            </p>
          </div>
