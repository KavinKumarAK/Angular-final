      font-size: 0.78rem;
      color: #94A3B8;
      font-weight: 500;
    }

    .presenter-state-badge {
      font-family: var(--font-code);
      font-size: 0.75rem;
      font-weight: 800;
      padding: 0.15rem 0.45rem;
      border-radius: 0.25rem;
