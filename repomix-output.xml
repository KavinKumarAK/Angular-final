})
export class HeaderComponent {
  state = inject(CharacterStateService);
  sound = inject(SoundEffectsService);
  presets = PRESETS;

  onSelectPreset(preset: CharacterPreset): void {
    this.state.loadPreset(preset);
  }

  toggleSound(): void {
    this.sound.toggleSound();
  }
}
