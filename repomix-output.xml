export class CodePeekerComponent {
  state = inject(CharacterStateService);
  private sanitizer = inject(DomSanitizer);

  codeFontSize = signal<number>(14);
  copied = signal<boolean>(false);

  @HostListener('document:keydown.escape')
  closeOnEscape(): void {
    if (this.state.codePeekerOpen()) this.state.toggleCodePeeker();
  }

  adjustFontSize(delta: number): void {
    this.codeFontSize.update((sz) => Math.max(12, Math.min(22, sz + delta)));
  }

  async copy(text: string): Promise<void> {
    try {
      await navigator.clipboard.writeText(text);
      this.copied.set(true);
      setTimeout(() => this.copied.set(false), 2000);
    } catch {
      this.copied.set(false);
    }
  }

  // Safe because paint() escapes all text (including the hero name) before adding <span>s.
  private trust(html: string): SafeHtml {
    return this.sanitizer.bypassSecurityTrustHtml(html);
  }

  /* ---------- plain-text code (what "Copy" copies and what gets highlighted) ---------- */

  readonly signalsCode = computed(() => {
    const s = this.state;
    const b = s.attackBreakdown();
    const hat = s.selectedHat();
    const st = s.stats();
    const power = s.selectedPower();
    const p = b.primaryKey;
    const q = b.secondaryKey;

    return `// 1. Writable Signals (State)
readonly characterName = signal<string>('${s.characterName()}');
readonly selectedWeapon = signal<WeaponItem>({ name: '${s.selectedWeapon().name}', baseDamage: ${b.base} });
readonly selectedHat = signal<HatItem>({ name: '${hat.name}', strengthBonus: ${hat.strengthBonus}, agilityBonus: ${hat.agilityBonus}, magicBonus: ${hat.magicBonus} });
readonly powerActive = signal<boolean>(${s.powerActive()});
readonly stats = signal<RpgStats>({ strength: ${st.strength}, agility: ${st.agility}, magic: ${st.magic} });

// 2. Computed Signal (re-runs only when a signal it reads changes)
readonly totalAttackPower = computed(() => {
  let damage = this.selectedWeapon().baseDamage;                          // ${b.base}
  damage += (st.${p} + hat.${p}Bonus) * ${b.primaryMult};        // ${b.primaryTotal} * ${b.primaryMult} = ${b.primaryBonus.toFixed(1)}
  damage += (st.${q} + hat.${q}Bonus) * ${b.secondaryMult};      // ${b.secondaryTotal} * ${b.secondaryMult} = ${b.secondaryBonus.toFixed(1)}
  if (powerActive && power.element === weapon.element) damage += 18;      // ${b.synergy ? '+18 resonance ACTIVE' : 'no resonance'}
  if (powerActive) damage *= ${power.powerMultiplier};                            // x${b.multiplier}
  return Math.round(damage);                                              // => ${b.total}
});`;
  });

  readonly bindingsCode = computed(() => {
    const s = this.state;
    return `<!-- 1. TWO-WAY BINDING: "banana in a box" [(ngModel)] -->
<input
  type="text"
  [(ngModel)]="characterName"
/>
<!-- Live in-memory value: "${s.characterName()}" -->

<!-- 2. PROPERTY BINDING: [style.fill] (component → DOM) -->
<path
  d="M 166 120 C 164 150 175 174 200 174 ..."
  [style.fill]="skinColor()"
/>
<!-- Evaluates to: "${s.skinColor()}" -->

<!-- 3. EVENT BINDING: (click) (DOM → component) -->
<button (click)="setWeapon(weapon)">
  Equip {{ weapon.name }}
</button>
<!-- Equipped right now: "${s.selectedWeapon().name}" -->

<!-- 4. CLASS BINDING: [class.name] -->
<button [class.card-active]="selectedWeapon().id === weapon.id">
<!-- card-active is currently on: ${s.selectedWeapon().id} -->`;
  });

  readonly controlFlowCode = computed(() => {
    const s = this.state;
    return `<!-- 1. CONTROL FLOW: @if adds / removes DOM nodes -->
@if (powerActive()) {
  <g class="power-aura-group">
    <circle r="145" fill="url(#${s.selectedPower().element}Glow)" />
  </g>
} @else {
  <span>Power Dormant</span>
}
<!-- powerActive() is ${s.powerActive()} → ${s.powerActive() ? 'aura is mounted' : 'aura is removed from the DOM'} -->

<!-- 2. CONTROL FLOW: @for loops, track is mandatory -->
@for (w of weapons; track w.id) {
  <button
    [class.card-active]="selectedWeapon().id === w.id"
    (click)="setWeapon(w)"
  >
    {{ w.symbolTag }} {{ w.name }}
  </button>
}`;
  });

  readonly stateJson = computed(() => {
    const s = this.state;
    return JSON.stringify(
      {
        characterName: s.characterName(),
        characterTitle: s.characterTitle(),
        selectedClass: s.selectedClass().name,
        skinColor: s.skinColor(),
        selectedHat: s.selectedHat().name,
        selectedOutfit: s.selectedOutfit().name,
        selectedWeapon: {
          name: s.selectedWeapon().name,
          element: s.selectedWeapon().element,
          baseDamage: s.selectedWeapon().baseDamage
        },
        powerActive: s.powerActive(),
        selectedPower: s.selectedPower().name,
        stats: s.stats(),
        availableStatPoints: s.availableStatPoints(),
        attackBreakdown: s.attackBreakdown(),
        defenseRating: s.defenseRating(),
        critChance: s.critChance() + '%',
        manaPool: s.manaPool() + ' MP',
        weaponSynergy: s.weaponSynergy()
      },
      null,
      2
    );
  });

  /* ---------- highlighted HTML (memoised, so the DOM only updates when the code changes) ---------- */
  readonly signalsHtml = computed(() =>
    this.trust(paint(this.signalsCode(), 'ts', this.state.lastUpdatedSignal().name))
  );
  readonly bindingsHtml = computed(() => this.trust(paint(this.bindingsCode(), 'html')));
  readonly controlFlowHtml = computed(() => this.trust(paint(this.controlFlowCode(), 'html')));
}
</file>

<file path="src/app/components/customizer-panel/customizer-panel.component.ts">
import { Component, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { DomSanitizer } from '@angular/platform-browser';
import { CharacterStateService } from '../../services/character-state.service';
import {
  CLASSES,
  HATS,
  OUTFITS,
  WEAPONS,
  SPECIAL_POWERS,
  SKIN_PALETTES,
} from '../../models/character.model';

@Component({
  selector: 'app-customizer-panel',
  standalone: true,
  imports: [CommonModule, FormsModule],
  template: `
    <div class="customizer-container card-glass">
      <!-- Section 1 - Hero Identity -->
      <div class="panel-section">
        <div class="section-title-row">
          <div class="title-group">
            <h3 class="section-title">SECTION 1 - HERO IDENTITY</h3>
            <span class="pill-twoway cursor-pointer" (click)="openBindingsTab()">
              Two-Way: [(ngModel)]
            </span>
          </div>
          <span class="section-subtext">Two-way reactive data stream</span>
        </div>

        <div class="name-input-container">
          <input
            type="text"
            class="hero-name-input"
            [(ngModel)]="heroName"
            placeholder="Enter Hero Name..."
            maxlength="24"
          />
        </div>
      </div>

      <!-- Section 2 - Class & Palette -->
      <div class="panel-section">
        <div class="section-title-row">
          <div class="title-group">
            <h3 class="section-title">SECTION 2 - CLASS &amp; PALETTE</h3>
            <span class="pill-signal cursor-pointer" (click)="openSignalsTab()">
              Signal: signal()
            </span>
          </div>
        </div>

        <!-- Class Grid -->
        <div class="class-grid">
          @for (cls of classes; track cls.id) {
            <button
              class="class-option-card card-glass-interactive"
              [class.card-active]="state.selectedClass().id === cls.id"
              (click)="state.setClass(cls)"
            >
              <div class="class-card-top">
                <svg class="class-svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" [innerHTML]="cls.icon"></svg>
                <span class="class-primary-tag">{{ cls.primaryStat.toUpperCase() }}</span>
              </div>
              <div class="class-label-wrap">
                <span class="class-label-name">{{ cls.name }}</span>
                <span class="class-label-sub">({{ cls.primaryStat === 'strength' ? 'Strength' : cls.primaryStat === 'magic' ? 'Magic' : 'Agility' }})</span>
              </div>
            </button>
          }
        </div>

        <!-- Skin Tone Selector -->
        <div class="skin-tone-container">
          <span class="tone-label">Skin Tone Selector:</span>
          <div class="swatches-wrap">
            @for (swatch of skinPalettes; track swatch.label) {
              <button
                class="tone-swatch"
                [style.backgroundColor]="swatch.value"
                [class.swatch-selected]="state.skinColor() === swatch.value"
                (click)="state.setSkinColor(swatch.value)"
                [title]="swatch.label"
              ></button>
            }
            <label class="native-picker-btn" title="Custom Hex Color">
              <input
                type="color"
                class="hidden-color-input"
                [value]="state.skinColor()"
                (input)="onColorInput($event)"
              />
              <svg class="picker-svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25c0-.585.132-1.139.367-1.636l10.58-10.58a2.25 2.25 0 013.182 0l2.122 2.121a2.25 2.25 0 010 3.182l-10.58 10.58c-.497.235-1.05.367-1.636.367z" />
              </svg>
            </label>
          </div>
        </div>
      </div>

      <!-- Section 3 - Gear & Armor -->
      <div class="panel-section">
        <div class="section-title-row">
          <div class="title-group">
            <h3 class="section-title">SECTION 3 - GEAR &amp; ARMOR</h3>
            <span class="pill-directive cursor-pointer" (click)="openDirectivesTab()">
              Control Flow: &#64;for
            </span>
          </div>
        </div>

        <div class="gear-option-block">
          <label class="gear-block-label">HEADGEAR / HELM OPTIONS:</label>
          <div class="headgear-chips-grid">
            @for (hat of displayedHats; track hat.id) {
              <button
                class="hat-chip-btn"
                [class.chip-selected]="state.selectedHat().id === hat.id"
                (click)="state.setHat(hat)"
              >
                <span class="chip-hat-name">{{ hat.name }}</span>
                <span class="rarity-badge" [class]="'badge-' + hat.rarity">
                  {{ hat.rarity }}
                </span>
              </button>
            }
          </div>
        </div>

        <div class="gear-option-block mt-3">
          <label class="gear-block-label">BODY OUTFIT OPTIONS:</label>
          <div class="outfit-radio-pills">
            @for (outfit of displayedOutfits; track outfit.id) {
              <button
                class="radio-pill-btn"
                [class.pill-selected]="state.selectedOutfit().id === outfit.id"
                (click)="state.setOutfit(outfit)"
              >
                <span class="radio-indicator"></span>
                <span class="outfit-pill-name">{{ outfit.name }}</span>
              </button>
            }
          </div>
        </div>
      </div>

      <!-- Section 4 - Weapon Arsenal -->
      <div class="panel-section">
        <div class="section-title-row">
          <div class="title-group">
            <h3 class="section-title">SECTION 4 - WEAPON ARSENAL</h3>
            <span class="pill-directive cursor-pointer" (click)="openDirectivesTab()">
              &#64;for (w of weapons; track w.id)
            </span>
          </div>
        </div>

        <div class="weapons-grid">
          @for (weapon of weapons; track weapon.id) {
            <button
              class="weapon-card card-glass-interactive"
              [class.card-active]="state.selectedWeapon().id === weapon.id"
              (click)="state.setWeapon(weapon)"
            >
              <div class="weapon-top-row">
                <span class="weapon-sym">{{ weapon.symbolTag }}</span>
                <span class="weapon-dmg">{{ weapon.baseDamage }} DMG</span>
              </div>
              <div class="weapon-title">{{ weapon.name }}</div>
              <div class="weapon-bottom-tags">
                <span class="scaling-tag">Scales: {{ weapon.scalingStat.toUpperCase() }}</span>
                <span class="element-tag" [class]="'elem-' + weapon.element">
                  {{ weapon.element }}
                </span>
              </div>
            </button>
          }
        </div>
      </div>

      <!-- Section 5 - Special Power & Stat Allocation -->
      <div class="panel-section">
        <div class="section-title-row">
          <div class="title-group">
            <h3 class="section-title">SECTION 5 - SPECIAL POWER &amp; STATS</h3>
            <span class="pill-computed cursor-pointer" (click)="openSignalsTab()">
              computed(() => ...)
            </span>
          </div>
        </div>

        <div class="power-toggle-strip">
          <div class="power-text-wrap">
            <span class="power-heading">Unleash Elemental Aura (&#64;if)</span>
            <span class="power-subheading">Mounts animated SVG particles &amp; +25% combat power</span>
          </div>
          <button
            class="switch-control"
            [class.switch-active]="state.powerActive()"
            (click)="state.togglePower()"
          >
            <span class="switch-ball"></span>
          </button>
        </div>

        <div class="stat-pool-header">
          <span class="stat-pool-title">RPG STAT POINTS:</span>
          <span class="pool-points-badge">Points Left: <strong>{{ state.availableStatPoints() }}</strong></span>
        </div>

        <div class="stats-stepper-list">
          <div class="stepper-row">
            <span class="stat-lbl text-flame">⚔️ STRENGTH</span>
            <div class="stepper-btns">
              <button class="step-btn" (click)="state.decreaseStat('strength')" [disabled]="state.stats().strength <= 2">-</button>
              <span class="step-val">{{ state.stats().strength }}</span>
              <button class="step-btn" (click)="state.increaseStat('strength')" [disabled]="state.availableStatPoints() <= 0">+</button>
            </div>
          </div>

          <div class="stepper-row">
            <span class="stat-lbl text-emerald">🏹 AGILITY</span>
            <div class="stepper-btns">
              <button class="step-btn" (click)="state.decreaseStat('agility')" [disabled]="state.stats().agility <= 2">-</button>
              <span class="step-val">{{ state.stats().agility }}</span>
              <button class="step-btn" (click)="state.increaseStat('agility')" [disabled]="state.availableStatPoints() <= 0">+</button>
            </div>
          </div>

          <div class="stepper-row">
            <span class="stat-lbl text-purple">🔮 MAGIC</span>
            <div class="stepper-btns">
              <button class="step-btn" (click)="state.decreaseStat('magic')" [disabled]="state.stats().magic <= 2">-</button>
              <span class="step-val">{{ state.stats().magic }}</span>
              <button class="step-btn" (click)="state.increaseStat('magic')" [disabled]="state.availableStatPoints() <= 0">+</button>
            </div>
          </div>
        </div>

        <div class="formula-box">
          <div class="formula-header-title">
            <span>🔬 HOW computed() RECALCULATES TOTAL POWER:</span>
          </div>
          <pre class="formula-pre"><code>{{ getFormulaText() }}</code></pre>
          <div class="formula-actions">
            <button class="reset-btn" (click)="state.resetStats()">Reset Points</button>
          </div>
        </div>
      </div>
    </div>
  `,
  styles: [`
