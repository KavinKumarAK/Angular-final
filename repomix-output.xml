<file path="src/styles.css">
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

:root {
  /* Typography */
  --font-ui: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-code: 'JetBrains Mono', monospace;
  --font-rpg: 'Cinzel', serif;

  /* Bright midnight background */
  --bg-space: #080b22;
  --bg-surface: #11163a;
  --bg-card: rgba(20, 28, 67, 0.78);
  --bg-card-hover: rgba(34, 45, 101, 0.9);
  --bg-card-active: rgba(29, 55, 112, 0.94);

  /* Borders */
  --border-dim: rgba(255, 255, 255, 0.13);
  --border-subtle: #2f3d7c;
  --border-focus: #38e8ff;

  /* Bright accent palette */
  --accent-cyan: #38e8ff;
  --accent-neon-yellow: #ffe45c;
  --accent-purple: #b58cff;
  --accent-flame: #ff8a4c;
  --accent-emerald: #45f0b0;
  --accent-rose: #ff6fae;

  /* Shadows and glow */
  --shadow-card:
    0 14px 34px -8px rgba(0, 0, 0, 0.58),
    0 0 1px 1px rgba(255, 255, 255, 0.08);
  --glow-cyan: 0 0 24px rgba(56, 232, 255, 0.42);

  --code-font-size: 0.88rem;
  --code-line-height: 1.6;
}

/* Presenter Mode Overrides */
.presenter-mode {
  --code-font-size: 1.15rem !important;
  --code-line-height: 1.75 !important;
  --border-dim: rgba(56, 232, 255, 0.4) !important;
  --bg-card: rgba(17, 24, 58, 0.96) !important;
}

/* Reset & Base Setup */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-ui);
  background-color: var(--bg-space);
  color: #f4f7ff;
  min-height: 100vh;
  background-image:
    radial-gradient(ellipse 60% 42% at 50% -10%, rgba(56, 232, 255, 0.22), transparent),
    radial-gradient(ellipse 45% 32% at 100% 100%, rgba(181, 140, 255, 0.2), transparent),
    radial-gradient(ellipse 35% 28% at 0% 85%, rgba(255, 111, 174, 0.12), transparent);
  background-attachment: fixed;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* Scrollbars */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: var(--bg-space);
}

::-webkit-scrollbar-thumb {
  background: #4c5db0;
  border-radius: 9999px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--accent-cyan);
}

/* Typography Helpers */
.font-rpg {
  font-family: var(--font-rpg);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.font-code {
  font-family: var(--font-code);
}

/* Glass Cards */
.card-glass {
  background: var(--bg-card);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--border-dim);
  border-radius: 0.75rem;
  box-shadow: var(--shadow-card);
}

.card-glass-interactive {
  background: var(--bg-card);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--border-dim);
  border-radius: 0.65rem;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  cursor: pointer;
}

.card-glass-interactive:hover {
  background: var(--bg-card-hover);
  border-color: var(--accent-cyan);
  transform: translateY(-2px);
  box-shadow:
    0 14px 28px -8px rgba(0, 0, 0, 0.62),
    0 0 20px rgba(56, 232, 255, 0.3);
}

.card-active {
  background: var(--bg-card-active) !important;
  border-color: var(--accent-cyan) !important;
  box-shadow: 0 0 20px rgba(56, 232, 255, 0.42) !important;
}

/* Concept Badges */
.pill-signal,
.pill-computed,
.pill-twoway,
.pill-directive {
  font-family: var(--font-code);
  font-size: 0.7rem;
  padding: 0.2rem 0.5rem;
  border-radius: 0.35rem;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  font-weight: 600;
}

.pill-signal {
  background: rgba(255, 111, 174, 0.14);
  color: var(--accent-rose);
  border: 1px solid rgba(255, 111, 174, 0.35);
}

.pill-computed {
  background: rgba(181, 140, 255, 0.14);
  color: var(--accent-purple);
  border: 1px solid rgba(181, 140, 255, 0.35);
}

.pill-twoway {
  background: rgba(255, 228, 92, 0.14);
  color: var(--accent-neon-yellow);
  border: 1px solid rgba(255, 228, 92, 0.36);
}

.pill-directive {
  background: rgba(56, 232, 255, 0.14);
  color: var(--accent-cyan);
  border: 1px solid rgba(56, 232, 255, 0.36);
}

/* Animations */
.anim-attacking {
  animation: attackSlash 0.45s ease-in-out;
}

.float-bob {
  animation: floatBob 3.5s ease-in-out infinite;
}

.float-bob.anim-attacking {
  animation: attackSlash 0.45s ease-in-out;
}

@keyframes floatBob {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-5px);
  }
}

@keyframes attackSlash {
  0% {
    transform: rotate(0deg) scale(1);
  }

  30% {
    transform: rotate(-25deg) scale(1.1) translateX(8px);
  }

  60% {
    transform: rotate(35deg) scale(1.15) translateX(20px);
  }

  100% {
    transform: rotate(0deg) scale(1);
  }
}
</file>

